# Local development / dry-run example.
# For production, use deploy/admin.env.example.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=0
COOKIE_SECURE=false
SESSION_SECRET=replace-with-a-random-64-character-hex-string
SESSION_MAX_AGE_HOURS=8

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-the-output-of-npm-run-hash-password

# Use the repository root itself for local dry-run testing.
REPO_DIR=.
STATE_DIR=.admin-data/state
REPO_URL=git@github.com:iamqq/eyepsy.git
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_SSH_KEY_PATH=admin/secrets/github_deploy_key
GIT_AUTHOR_NAME=Content Admin
GIT_AUTHOR_EMAIL=admin@ulianapsy.com
GITHUB_REPO_URL=https://github.com/iamqq/eyepsy

MAX_UPLOAD_MB=10
BUILD_TIMEOUT_MS=120000
DRY_RUN=true
