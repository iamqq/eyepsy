{
  "name": "eyepsy-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Content admin service for the eyepsy static site",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "start:node22": "npx -y -p node@22.23.4 node server.mjs",
    "dev": "npx -y -p node@22.23.4 node --watch server.mjs",
    "test": "npx -y -p node@22.23.4 node --test test/*.test.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "sharp": "^0.33.5",
    "simple-git": "^3.27.0",
    "zod": "^3.24.1"
  }
}
