NODE_ENV=production
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=1
COOKIE_SECURE=true
SESSION_SECRET=replace-with-a-random-64-character-hex-string
SESSION_MAX_AGE_HOURS=8

ADMIN_USERNAME=replace-me
ADMIN_PASSWORD_HASH=replace-with-the-output-of-npm-run-hash-password

REPO_DIR=/var/lib/eyepsy-admin/repo
STATE_DIR=/var/lib/eyepsy-admin/state
REPO_URL=git@github.com:iamqq/eyepsy.git
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_SSH_KEY_PATH=/etc/eyepsy-admin/deploy_key
GIT_AUTHOR_NAME=Content Admin
GIT_AUTHOR_EMAIL=admin@ulianapsy.com
GITHUB_REPO_URL=https://github.com/iamqq/eyepsy

MAX_UPLOAD_MB=10
BUILD_TIMEOUT_MS=120000
DRY_RUN=false
