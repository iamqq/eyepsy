---
import { Image } from "astro:assets";
import site from "../data/site.json";
import { imageAsset } from "../lib/images";

interface Props {
  nav?: { label: string; href: string }[];
}
const { nav = site.nav } = Astro.props;
---

<header
  class="sticky top-0 z-40 border-b border-line/70 bg-cream/85 backdrop-blur supports-[backdrop-filter]:bg-cream/70"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a href="/" class="flex items-center gap-2.5" aria-label="На главную">
      <Image
        src={imageAsset("/images/logo/eye.png")}
        alt=""
        width={36}
        height={26}
        class="h-6 w-auto"
        loading="eager"
      />
      <span class="font-display text-sm font-semibold tracking-wide text-dusk-700 sm:text-base">
        Психологическая помощь
      </span>
    </a>

    <nav class="hidden items-center gap-7 text-sm md:flex" aria-label="Основная навигация">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-muted transition-colors hover:text-dusk-700"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-dusk-700 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Меню"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-line/70 bg-cream px-5 pb-4 pt-2 md:hidden"
    aria-label="Мобильная навигация"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="block border-b border-line/60 py-3 text-base text-ink last:border-0"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const btn = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(open));
    });
  }
</script>
