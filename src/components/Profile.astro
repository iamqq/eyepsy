---
import { Image } from "astro:assets";
import type { Person, Certificate, TopicsData } from "../lib/content";
import { imageAsset } from "../lib/images";
import site from "../data/site.json";
import Certificates from "./Certificates.astro";
import TopicCard from "./TopicCard.astro";

interface Props {
  person: Person;
  certificates: Certificate[];
  topics?: TopicsData;
}
const { person, certificates, topics } = Astro.props;
---

<!-- Hero -->
<section id="about" class="relative isolate overflow-hidden bg-dusk-900">
  <Image
    src={imageAsset(site.hero.image)}
    alt=""
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    loading="eager"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-dusk-900/90 via-dusk-900/75 to-dusk-900/40"
  >
  </div>
  <div
    class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1.35fr_1fr] lg:items-center"
  >
    <div class="text-cream">
      <p class="text-xs uppercase tracking-[0.2em] text-rose-light">{person.role}</p>
      <h1 class="mt-3 text-3xl sm:text-4xl">{person.name}</h1>
      {
        person.badge && (
          <p class="mt-4 inline-block rounded-full border border-cream/40 px-3 py-1 text-xs text-cream/90">
            {person.badge}
          </p>
        )
      }
      <div class="mt-6 space-y-3 text-dusk-50/90">
        {person.intro.map((p) => <p>{p}</p>)}
      </div>
      {
        person.approach && (
          <p class="mt-6 border-l-2 border-rose pl-4 italic text-cream/90">{person.approach}</p>
        )
      }
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#contacts"
          class="rounded-full bg-rose px-6 py-3 text-sm font-medium text-dusk-900 transition hover:bg-rose-light"
        >
          Контакты для записи
        </a>
        <a
          href="#certificates"
          class="rounded-full border border-cream/50 px-6 py-3 text-sm font-medium text-cream transition hover:bg-cream/10"
        >
          Дипломы и сертификаты
        </a>
      </div>
    </div>

    <div class="justify-self-center lg:justify-self-end">
      <Image
        src={imageAsset(person.photo)}
        alt={person.name}
        width={540}
        height={675}
        loading="eager"
        class="aspect-[4/5] w-full max-w-[18rem] rounded-2xl object-cover shadow-2xl ring-1 ring-cream/20"
        style={`object-position:${person.cardPhotoPosition ?? "center"}`}
      />
    </div>
  </div>
</section>

<!-- Quick facts -->
<section class="border-b border-line bg-cream">
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        person.facts.map((f) => (
          <li class="flex items-start gap-3 text-sm text-ink">
            <span class="mt-0.5 text-rose-dark" aria-hidden="true">
              ✓
            </span>
            <span>{f}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Topics -->
{
  topics && (
    <section id="topics" class="bg-lav/40 py-16 sm:py-20">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <h2 class="text-2xl text-dusk-700 sm:text-3xl">{topics.title}</h2>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {topics.items.map((topic) => (
            <TopicCard title={topic.title} text={topic.text} />
          ))}
        </div>
        <p class="mt-8 max-w-3xl text-sm leading-relaxed text-muted">{topics.note}</p>
      </div>
    </section>
  )
}

<!-- Extra sections (e.g. clinical psychodiagnostics) -->
{
  person.sections.map((section, i) => (
    <section class:list={["py-16 sm:py-20", i % 2 === 0 && "bg-lav/30"]}>
      <div class="mx-auto max-w-3xl px-5 sm:px-8">
        <h2 class="text-2xl text-dusk-700 sm:text-3xl">{section.title}</h2>
        {section.paragraphs && (
          <div class="mt-5 space-y-4 leading-relaxed text-ink/90">
            {section.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        )}
        {section.list && (
          <div class="mt-7">
            <p class="font-medium text-dusk-700">{section.list.title}</p>
            <ul class="mt-3 space-y-2">
              {section.list.items.map((item) => (
                <li class="flex gap-3 text-ink/90">
                  <span class="text-rose-dark" aria-hidden="true">
                    ✓
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {section.facts && (
          <ul class="mt-7 flex flex-wrap gap-3">
            {section.facts.map((f) => (
              <li class="rounded-full bg-dusk-50 px-4 py-1.5 text-sm text-dusk-700">{f}</li>
            ))}
          </ul>
        )}
      </div>
    </section>
  ))
}

<!-- Education & experience -->
<section id="education" class="py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <h2 class="text-2xl text-dusk-700 sm:text-3xl">Образование и профессиональный опыт</h2>
    <p class="mt-5 text-lg text-ink">{person.education.base}</p>

    <h3 class="mt-10 font-display text-xl text-dusk-700">
      {person.education.experienceTitle}
    </h3>
    <div class="mt-3 space-y-3 leading-relaxed text-ink/90">
      {person.education.experience.map((p) => <p>{p}</p>)}
    </div>

    <h3 class="mt-10 font-display text-xl text-dusk-700">
      {person.education.additionalTitle}
    </h3>
    <ul class="mt-4 grid gap-x-10 gap-y-2 sm:grid-cols-2">
      {
        person.education.additional.map((item) => (
          <li class="flex gap-3 text-sm text-ink/90">
            <span class="text-rose-dark" aria-hidden="true">
              ✓
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Certificates gallery -->
<section id="certificates" class="bg-lav/30 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <h2 class="text-2xl text-dusk-700 sm:text-3xl">Дипломы и сертификаты</h2>
    <p class="mt-3 max-w-2xl text-muted">
      Нажмите на документ, чтобы рассмотреть его крупнее.
    </p>
    <div class="mt-8">
      <Certificates items={certificates} />
    </div>
  </div>
</section>

<!-- Telegram channel -->
{
  person.telegramChannel && (
    <section id="telegram" class="py-16 sm:py-20">
      <div class="mx-auto grid max-w-6xl items-center gap-8 px-5 sm:px-8 lg:grid-cols-[1.1fr_1fr]">
        <div class="order-2 lg:order-1">
          <h2 class="text-2xl text-dusk-700 sm:text-3xl">{person.telegramChannel.title}</h2>
          {person.telegramChannel.text && (
            <p class="mt-4 max-w-xl leading-relaxed text-ink/90">{person.telegramChannel.text}</p>
          )}
          <a
            href={person.telegramChannel.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-block rounded-full bg-rose px-6 py-3 text-sm font-medium text-dusk-900 transition hover:bg-rose-light"
          >
            {person.telegramChannel.buttonLabel}
          </a>
        </div>
        <a
          href={person.telegramChannel.url}
          target="_blank"
          rel="noopener noreferrer"
          class="order-1 block justify-self-center lg:order-2 lg:justify-self-end"
        >
          <Image
            src={imageAsset(person.telegramChannel.image)}
            alt={person.telegramChannel.imageAlt ?? person.telegramChannel.title}
            loading="lazy"
            class="w-full max-w-xs rounded-2xl border border-line shadow-lg"
          />
        </a>
      </div>
    </section>
  )
}

<!-- FAQ -->
{
  person.faq && person.faq.length > 0 && (
    <section id="faq" class="py-16 sm:py-20">
      <div class="mx-auto max-w-3xl px-5 sm:px-8">
        <h2 class="text-2xl text-dusk-700 sm:text-3xl">Частые вопросы</h2>
        <div class="mt-6 divide-y divide-line border-y border-line">
          {person.faq.map((item) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-dusk-700">
                <span>{item.question}</span>
                <span class="text-rose-dark transition group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="mt-3 leading-relaxed text-ink/90">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<!-- How to book -->
<section id="appointment" class="bg-lav/30 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <h2 class="text-2xl text-dusk-700 sm:text-3xl">Как записаться</h2>
    <ol class="mt-8 grid gap-5 sm:grid-cols-3">
      <li class="rounded-xl border border-line bg-cream p-6">
        <p class="font-display text-lg font-semibold text-dusk-700">1. Напишите</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Позвоните или напишите в Telegram / WhatsApp, чтобы обсудить запрос и удобное время.
        </p>
      </li>
      <li class="rounded-xl border border-line bg-cream p-6">
        <p class="font-display text-lg font-semibold text-dusk-700">2. Договоритесь о встрече</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Выберите онлайн или очный формат в Санкт-Петербурге и удобный слот.
        </p>
      </li>
      <li class="rounded-xl border border-line bg-cream p-6">
        <p class="font-display text-lg font-semibold text-dusk-700">3. Приходите</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Первая встреча — знакомство и обсуждение запроса. Дальнейший план работы согласуем вместе.
        </p>
      </li>
    </ol>
  </div>
</section>

<!-- Contacts -->
<section id="contacts" class="bg-dusk-700 py-16 text-cream sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <h2 class="text-2xl text-cream sm:text-3xl">Позвольте себе помочь</h2>
    <p class="mt-3 text-dusk-100">Контакты для записи</p>
    <ul class="mt-8 flex flex-wrap gap-3">
      <li>
        <a
          href={`tel:${person.phone}`}
          class="rounded-full bg-cream px-6 py-3 text-sm font-medium text-dusk-900 transition hover:bg-white"
        >
          {person.phoneDisplay}
        </a>
      </li>
      <li>
        <a
          href={person.telegram}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-cream/50 px-6 py-3 text-sm font-medium text-cream transition hover:bg-cream/10"
        >
          Telegram
        </a>
      </li>
      <li>
        <a
          href={person.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-cream/50 px-6 py-3 text-sm font-medium text-cream transition hover:bg-cream/10"
        >
          WhatsApp
        </a>
      </li>
    </ul>
  </div>
</section>
