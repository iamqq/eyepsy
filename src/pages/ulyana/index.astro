---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Profile from "../../components/Profile.astro";
import { getPerson, certificatesBySlug, site } from "../../lib/content";
import { imageAsset } from "../../lib/images";

const person = getPerson("ulyana")!;
const certificates = certificatesBySlug["ulyana"] ?? [];
const photo = imageAsset(person.photo);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  jobTitle: person.role,
  image: new URL(photo.src, site.url).href,
  url: new URL(`/${person.slug}/`, site.url).href,
  telephone: person.phone,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.city,
    addressCountry: "RU",
  },
};

const nav = [
  { label: "О нас", href: "/#team" },
  { label: "Образование", href: "#education" },
  { label: "С чем мы работаем", href: "/#topics" },
  { label: "Контакты", href: "#contacts" },
];
---

<BaseLayout
  title={person.name}
  description={`${person.name} — ${person.role}. Психологическое консультирование в Санкт-Петербурге и онлайн, клиническая психодиагностика.`}
  image={photo.src}
  nav={nav}
  jsonLd={jsonLd}
>
  <Profile person={person} certificates={certificates} />
</BaseLayout>
