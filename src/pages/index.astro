---
import BaseLayout from "../layouts/BaseLayout.astro";
import Profile from "../components/Profile.astro";
import { person, certificates, site, topics } from "../lib/content";
import { imageAsset } from "../lib/images";

const photo = imageAsset(person.photo);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: person.name,
    jobTitle: person.role,
    image: new URL(photo.src, site.url).href,
    url: new URL("/", site.url).href,
    telephone: person.phone,
    sameAs: [person.telegram, person.telegramChannel?.url].filter(
      (value): value is string => Boolean(value),
    ),
    address: {
      "@type": "PostalAddress",
      addressLocality: site.city,
      addressCountry: "RU",
    },
    knowsAbout: topics.items.map((topic) => topic.title),
  },
  ...(person.faq && person.faq.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: person.faq.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: item.answer,
            },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  description={`${person.name} — ${person.role}. Психологическое консультирование в Санкт-Петербурге и онлайн, клиническая психодиагностика.`}
  image={photo.src}
  jsonLd={jsonLd}
>
  <Profile person={person} certificates={certificates} topics={topics} />
</BaseLayout>
